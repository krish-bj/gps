# ===================================================================
# GPS VEHICLE TRACKING BACKEND - ENVIRONMENT CONFIGURATION TEMPLATE
# ===================================================================

# Application Mode & Identifiers
APP_NAME="GPS Vehicle Tracking System Backend"
APP_ENV="development"        # Options: development, testing, production
DEBUG=true
API_V1_PREFIX="/api/v1"

# Database Configuration
# Local SQLite (Development):
DATABASE_URL="sqlite:///./vehicle_tracking.db"
# PostgreSQL (Production / Docker):
# DATABASE_URL="postgresql://postgres:postgrespassword@db:5432/vehicle_tracking_db"

# JWT Authentication Configuration
# MANDATORY IN PRODUCTION: Must be a secure 32+ character random string
JWT_SECRET_KEY="supersecretjwtkey_vehicle_tracking_2026_dev_prod"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080  # 7 days

# MQTT Broker Configuration
MQTT_HOST="localhost"
MQTT_PORT=1883
MQTT_USERNAME="gps_ingest_user"
MQTT_PASSWORD="gps_secure_pass_2026"
MQTT_TOPIC_PREFIX="vehicles/+/gps"
MQTT_ENABLED=true

